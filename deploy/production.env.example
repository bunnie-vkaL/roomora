# Reference only. Inject actual values through the hosting secret manager.
# config.production_settings does not read the local development .env.
DJANGO_SETTINGS_MODULE=config.production_settings
SECRET_KEY=
ALLOWED_HOSTS=roomora.example
CSRF_TRUSTED_ORIGINS=https://roomora.example
POSTGRES_DB=roomora
POSTGRES_USER=roomora
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
STATIC_ROOT=/srv/roomora/staticfiles
MEDIA_ROOT=/srv/roomora/public_media
ROOMORA_PRIVATE_MEDIA_ROOT=/srv/roomora/private_media
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=hello@roomora.example
# Set to 1 only behind an edge which overwrites X-Forwarded-Proto.
ROOMORA_TRUST_PROXY_PROTO=0
# Only explicitly trusted proxy CIDRs; edge must replace X-Roomora-Client-IP.
ROOMORA_AUTH_TRUSTED_PROXIES=
ROOMORA_JOURNEY_ENABLED=True
