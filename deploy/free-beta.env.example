# Reference only. Inject through a private environment/WSGI config, outside source.
# The public profiles never load the development .env.
DJANGO_SETTINGS_MODULE=config.free_beta_settings
SECRET_KEY=
ALLOWED_HOSTS=your-account.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://your-account.pythonanywhere.com
STATIC_ROOT=/home/your-account/roomora_static
MEDIA_ROOT=/home/your-account/roomora_media
ROOMORA_PRIVATE_MEDIA_ROOT=/home/your-account/roomora_private
ROOMORA_DATA_ROOT=/home/your-account/roomora_data
DEFAULT_FROM_EMAIL=
BREVO_API_KEY=
# Enable only after verifying the host overwrites X-Forwarded-Proto.
ROOMORA_TRUST_PROXY_PROTO=0
ROOMORA_AUTH_TRUSTED_PROXIES=
ROOMORA_JOURNEY_ENABLED=True
